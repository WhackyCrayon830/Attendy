# For compose.production.yaml, set this to the connection URL for your PostgreSQL server.
# Use a host reachable from the Docker container; do not use localhost for a database outside the app container.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Generate a unique secret for the production deployment (for example: openssl rand -base64 32).
AUTH_SECRET=replace-with-a-random-production-secret

# Public app URL used by Auth.js for redirects (for example, https://attendy.example.com).
AUTH_URL=http://localhost:3000
